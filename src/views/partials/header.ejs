<!DOCTYPE html>
<html lang="en">
    <%- include('head') %>
<body class="<%= locals.bodyClass || '' %>">
    <header>
        <%- include('nav') %>
    </header>
    <% 
    const getFlash = locals.flash || (typeof flash === 'function' ? flash : null);
    const messages = getFlash ? getFlash() : { success: [], error: [], warning: [], info: [] };
    const hasMessage = Object.values(messages).some(arr => arr.length > 0);
    %>
        <% if (hasMessage) { %>
            <div class="flash-messages">
                <% Object.keys(messages).forEach(type => { %>
                    <% (messages[type] || []).forEach(message => { %>
                        <div class="flash <%= type %>">
                            <%= message %>
                        </div> 
                    <% }); %>
                <% }); %>
            </div>
        <% } %>
</body>