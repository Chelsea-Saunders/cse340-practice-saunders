<%- include('partials/header') %>
<main>
    <h1><%=title%></h1>

    <div class="about-me">
        <p class="welcome">Hi! My name is Chelsea Saunders and I live in the great state of Idaho.</p>
        <img id="me" src="/images/me.webp" alt="me" >
        <p>A few of my favorite things are:</p>
        <ul>
            <li id="fam-time">
                <span class="li-title">Spending time with my family</span><br>
                <img src="/images/gocart.webp" alt="riding a gocart">
                <img src="/images/IslandPark.webp" alt="kids making sasquash faces"><br>
                <img src="/images/bRiver.webp" alt="floating the Boise River">
                <img src="/images/zipline.webp" alt="ziplining"><br>
            </li>
            <li id="slow-down">
                <span class="li-title">Slowing down to notice God's creations</span><br>
                <img src="/images/bumblebee.webp" alt="bumblebee">
                <img src="/images/flower.webp" alt="a flower"><br>
                <img src="/images/sunset.webp" alt="a sunset"><br>
            </li>
            <li id="outside">
                <span class="li-title">Being outside</span><br>
                <img src="/images/sunsetJump.webp" alt="kids jumping on the trampoline at sunset">
                <img src="/images/leaves-lake.webp" alt="leaves and a lake"><br>
            </li>
            <li id="temple">
                <span class="li-title">Spending time in the temple</span><br>
                <img src="/images/temple.webp" alt="spending time at the temple"><br>
            </li>
        </ul>
    </div>
</main>
<%- include('partials/footer') %>
</html>